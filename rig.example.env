# Параметры конкретного стенда. Скопируй в rig.local.env и заполни под себя.
#
#   cp rig.example.env rig.local.env
#
# rig.local.env в .gitignore и не коммитится: там адрес, хостнейм и SSID твоей
# домашней сети. Это не секреты в строгом смысле (192.168.x.x снаружи бесполезен),
# но по SSID Wi-Fi в публичных базах находится дом — поэтому в публичный репо не идёт.
# Приватный SSH-ключ и HF_TOKEN здесь НЕ хранятся: ключ лежит в ~/.ssh/, токен в env.
#
# Формат — простые KEY=value без кавычек и пробелов вокруг "=", чтобы файл читался
# и агентом (cat), и скриптами, и шеллом (set -a; source rig.local.env; set +a).
#
# Не знаешь, что писать — скажи агенту «настрой стенд», он проведёт по вопросам
# и заполнит этот файл сам (скилл rig-setup).

# ─── Обязательное для любого режима ──────────────────────────────────────────

# Имя стенда. Ему соответствует каталог rigs/<RIG_NAME>/ с описанием железа,
# моделями и историей. Пиши по карте и объёму VRAM: rtx5070ti-16gb, rtx3060-12gb.
RIG_NAME=

# Где работает агент относительно ПК с видеокартой:
#   local — агент запущен прямо на этом Windows-ПК, команды идут в локальный PowerShell
#   ssh   — агент на другой машине (макбук), команды идут по SSH
# От этого зависит половина процедур: в local-режиме не нужны ни SSH-ключи,
# ни правила файрвола, ни возня с VPN — см. docs/remote-access.md.
RIG_MODE=local

# Адрес OpenAI-совместимого API llama-swap.
#   local: http://127.0.0.1:8080/v1
#   ssh:   http://<IP-ПК-в-LAN>:8080/v1
RIG_API=http://127.0.0.1:8080/v1

# Корневой каталог установки на ПК: llama.cpp, модели, конфиг llama-swap, run-скрипты.
RIG_ROOT=C:\llm

# ─── Только для RIG_MODE=ssh (в local-режиме оставь пустыми) ─────────────────

# IP ПК в локальной сети. Статический или прибитый в DHCP роутера —
# иначе адрес уедет после перезагрузки и все команды перестанут работать.
RIG_HOST=

# Windows-юзер, под которым ходим по SSH. Заводи отдельную ASCII-учётку:
# кириллическое имя пользователя ломает кодировку в SSH-сессии.
RIG_SSH_USER=

# Приватный ключ на стороне агента.
RIG_SSH_KEY=~/.ssh/

# Имя ПК в сети. Нужно редко (диагностика, поиск в логах роутера).
RIG_HOSTNAME=

# SSID Wi-Fi, к которому подключён ПК. Нужен ровно для одного:
# Windows периодически сбрасывает профиль сети в Public, и файрвол начинает резать
# порт 22 — чинится через Set-NetConnectionProfile по этому имени.
RIG_WIFI_SSID=
